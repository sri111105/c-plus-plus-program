#include <iostream>
#include <string>
#include <cctype>
using namespace std;
string CapitalizeDecapitalize(string str, int length, char c) {
    char replacement = islower(c) ? (char)toupper(c) : (char)tolower(c);
    for (int i = 0; i < length; i++) {
        if (str[i] == c) {
            str[i] = replacement;
        }
    }
    return str;
}
int main() {
    string str;
    getline(cin, str);
    char c;
    cin >> c;
    cout << CapitalizeDecapitalize(str, str.length(), c) << endl;
    return 0;
}
