#include<bits/stdc++.h>
using namespace std;
int main() 
{
    string s;
    cin>>s;
    int n=s.length();
   int i=0;
    while(i<n)
        {
            char ch=s[i++];
            int count=0;
            while(i<n && isdigit(s[i]))
                {
                    count=count*10+(s[i]-'0');
                    i++;
                }
            if(count==0)
            {
                count =1;
            }
            for(int j=0;j<count;j++)
                {
                    cout <<ch;
                }
        }
    return 0;
}
