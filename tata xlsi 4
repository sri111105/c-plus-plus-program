#include <iostream>
#include <string>
using namespace std;
string compressString(string s) {
    string ans = "";
    int count = 1;
    for (int i = 0; i < s.length(); i++) {
        if (i + 1 < s.length() && s[i] == s[i + 1]) {
            count++;
        } else {
            ans += s[i];
            ans += to_string(count);
            count = 1;
        }
    }
    return ans; 
}
int main() {
    string s;
    cin >> s;
    cout << compressString(s) << endl;
    return 0;
}
