#include <iostream>
#include <string>
using namespace std;
void countBorrows(long long number1, long long number2) {
    // Step 1: Check if subtraction is possible
    if (number2 < number1) {
        cout << "Not possible" << endl;
        return;
    }
    int borrow_count = 0;
    int carry = 0;
    while (number2 > 0 || number1 > 0) {
        // Extract the last digits
        int d2 = (number2 % 10) - carry;
        int d1 = number1 % 10;

        // Check if we need to borrow
        if (d2 < d1) {
            borrow_count++;
            carry = 1; // Borrowed 1 from the next column
        } else {
            carry = 0; // No borrow needed
        }

        // Move to the next digit (remove the last digit)
        number1 /= 10;
        number2 /= 10;
    }
    cout << borrow_count << endl;
}
int main() {
    long long number1, number2;
    if (cin >> number1 >> number2) {
        countBorrows(number1, number2);
    }
    return 0;
}
